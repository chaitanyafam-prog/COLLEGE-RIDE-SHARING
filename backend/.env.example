# Copy to .env and fill in. Get the string from Supabase: Dashboard > Connect > Connection string.
# If direct connection fails (IPv6-only), use the "Session pooler" string instead.
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.dznerghnkvxoevwaofkr.supabase.co:5432/postgres

# Auth: generate a secret with  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
